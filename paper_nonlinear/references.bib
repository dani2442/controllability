@article{yuanDataDrivenOptimalControl2022,
  title = {Data-{{Driven Optimal Control}} of {{Bilinear Systems}}},
  author = {Yuan, Zhenyi and Cortes, Jorge},
  date = {2022},
  journaltitle = {IEEE Control Systems Letters},
  shortjournal = {IEEE Control Syst. Lett.},
  volume = {6},
  eprint = {2112.15510},
  eprinttype = {arXiv},
  eprintclass = {math},
  pages = {2479--2484},
  issn = {2475-1456},
  doi = {10.1109/LCSYS.2022.3164983},
  url = {http://arxiv.org/abs/2112.15510},
  urldate = {2026-02-23},
  abstract = {This paper develops a method to learn optimal controls from data for bilinear systems without a priori knowledge of the system dynamics. Given an unknown bilinear system, we first characterize when the available data is suitable to solve the optimal control problem. This characterization leads us to propose an online control experiment design procedure that guarantees that any input/state trajectory can be represented as a linear combination of collected input/state data matrices. Leveraging this data-based representation, we transform the original optimal control problem into an equivalent data-based optimization problem with bilinear constraints. We solve the latter by iteratively employing a convex-concave procedure to convexify it and find a locally optimal control sequence. Simulations show that the performance of the proposed data-based approach is comparable with model-based methods.},
  keywords = {Electrical Engineering and Systems Science - Systems and Control,Mathematics - Optimization and Control},
  file = {C\:\\Users\\id94ebid\\Zotero\\storage\\658V8NN3\\Yuan and Cortes - 2022 - Data-Driven Optimal Control of Bilinear Systems.pdf;C\:\\Users\\id94ebid\\Zotero\\storage\\FSCSW6H8\\2112.html}
}
