@article{bilgicDataDrivenPredictiveControl2024,
  title = {Data-{{Driven Predictive Control}} of {{Bilinear HVAC Dynamics}}—{{An Experimental Case Study}}},
  author = {Bilgic, Deborah and Harding, Alexander and Faulwasser, Timm},
  date = {2024},
  journaltitle = {IEEE Control Systems Letters},
  shortjournal = {IEEE Control Syst. Lett.},
  volume = {8},
  pages = {3009--3014},
  issn = {2475-1456},
  doi = {10.1109/LCSYS.2024.3519224},
  url = {https://ieeexplore.ieee.org/document/10804655/},
  urldate = {2026-02-22},
  abstract = {Buildings are responsible for around 40\% of the global energy demand. In order to effectively reduce the high energy consumption of HVAC systems while maintaining comfortable indoor climate, tailored control schemes are promising. Since the derivation of physical models of individual HVAC systems is time consuming, data-driven methods are a promising alternative. This letter proposes a framework for data-driven predictive control of HVAC system with bilinear system dynamics, which compensates for prediction errors via constraint adaptation through a bias term. The proposed scheme combines an extension of Willems’ fundamental lemma to bilinear systems with the consideration of multiple data-sets. To evaluate the efficacy of the data-driven control scheme, an experimental case study is performed under realistic conditions. In comparison with an existing simple control scheme, our results demonstrate energy efficient operation and successful compensation of prediction errors.},
  keywords = {Bilinear systems,Buildings,constraint adaptation,data-driven predictive control,Energy consumption,Heating systems,HVAC,Nonlinear systems,Optimal control,Predictive control,System dynamics,Trajectory,Vectors,Willems’ fundamental lemma},
  file = {C:\Users\id94ebid\Zotero\storage\V5BV44CM\Bilgic et al. - 2024 - Data-Driven Predictive Control of Bilinear HVAC Dynamics—An Experimental Case Study.pdf}
}

