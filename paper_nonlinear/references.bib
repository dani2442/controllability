@article{kallenbergLocalConditioningDawsonWatanabe2013,
  title = {Local Conditioning in {{Dawson-Watanabe}} Superprocesses},
  author = {Kallenberg, Olav},
  date = {2013-01-01},
  journaltitle = {The Annals of Probability},
  shortjournal = {Ann. Probab.},
  volume = {41},
  number = {1},
  eprint = {1302.0968},
  eprinttype = {arXiv},
  eprintclass = {math.PR},
  issn = {0091-1798},
  doi = {10.1214/11-AOP702},
  url = {http://arxiv.org/abs/1302.0968},
  urldate = {2026-07-29},
  abstract = {Consider a locally finite Dawson-Watanabe superprocess \$ξ=(ξ\_t)\$ in \$\textbackslash mathsf\{R\}\textasciicircum d\$ with \$d\textbackslash geq2\$. Our main results include some recursive formulas for the moment measures of \$ξ\$, with connections to the uniform Brownian tree, a Brownian snake representation of Palm measures, continuity properties of conditional moment densities, leading by duality to strongly continuous versions of the multivariate Palm distributions, and a local approximation of \$ξ\_t\$ by a stationary cluster \$\textbackslash tildeη\$ with nice continuity and scaling properties. This all leads up to an asymptotic description of the conditional distribution of \$ξ\_t\$ for a fixed \$t{$>$}0\$, given that \$ξ\_t\$ charges the \$\textbackslash varepsilon\$-neighborhoods of some points \$x\_1,\textbackslash ldots,x\_n\textbackslash in \textbackslash mathsf\{R\}\textasciicircum d\$. In the limit as \$\textbackslash varepsilon\textbackslash to0\$, the restrictions to those sets are conditionally independent and given by the pseudo-random measures \$\textbackslash tildeξ\$ or \$\textbackslash tildeη\$, whereas the contribution to the exterior is given by the Palm distribution of \$ξ\_t\$ at \$x\_1,\textbackslash ldots,x\_n\$. Our proofs are based on the Cox cluster representations of the historical process and involve some delicate estimates of moment densities.},
  keywords = {Mathematics - Probability},
  file = {C\:\\Users\\id94ebid\\Zotero\\storage\\DNEAK5HA\\Kallenberg - 2013 - Local conditioning in Dawson-Watanabe superprocesses.pdf;C\:\\Users\\id94ebid\\Zotero\\storage\\ZEZH8SJA\\1302.html}
